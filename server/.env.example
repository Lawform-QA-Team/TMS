# ============================================================
# TMS Server 환경 변수 예시
# 복사 후 .env로 이름 변경 후 값 입력
# ============================================================

NODE_ENV=development
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/tms_db

# Auth
JWT_SECRET_KEY=your-strong-secret-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# Redis
REDIS_URL=redis://localhost:6379

# Jira (실제 Jira 인스턴스 사용 시)
JIRA_SERVER_URL=https://your-org.atlassian.net
JIRA_USERNAME=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=TEST
JIRA_WEBHOOK_SECRET=your-webhook-secret
JIRA_WATCHED_PROJECTS=PROJECT1,PROJECT2

# LLM (Jira→QA 자동화 파이프라인)
ANTHROPIC_API_KEY=sk-ant-...

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0XXXXXXXXX

# CORS (쉼표 구분, 또는 * 전체 허용)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
