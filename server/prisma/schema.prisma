generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int                   @id @default(autoincrement())
  username                 String                @unique(map: "username") @db.VarChar(80)
  email                    String                @unique(map: "email") @db.VarChar(120)
  passwordHash             String                @map("password_hash") @db.VarChar(255)
  firstName                String?               @map("first_name") @db.VarChar(50)
  lastName                 String?               @map("last_name") @db.VarChar(50)
  role                     String                @default("viewer") @db.VarChar(20)
  isActive                 Boolean               @default(true) @map("is_active")
  lastLogin                DateTime?             @map("last_login") @db.DateTime(0)
  createdAt                DateTime              @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                DateTime              @updatedAt @map("updated_at") @db.DateTime(0)
  AiConversations          AiConversations[]
  assignedAutomationTests  AutomationTest[]      @relation("AssigneeAutomationTests")
  createdAutomationTests   AutomationTest[]      @relation("CreatorAutomationTests")
  createdTestCases         TestCase[]            @relation("CreatorTestCases")
  cicdIntegrations         CICDIntegration[]
  comments                 Comment[]
  createdReports           CustomReport[]
  mentions                 Mention[]
  notificationSettings     NotificationSettings?
  notifications            Notification[]
  assignedPerformanceTests PerformanceTest[]     @relation("AssigneePerformanceTests")
  createdPerformanceTests  PerformanceTest[]     @relation("CreatorPerformanceTests")
  executedReports          ReportExecution[]
  assignedTestCases        TestCase[]            @relation("AssigneeTestCases")
  createdTestDataSets      TestDataSet[]
  createdSchedules         TestSchedule[]
  UserAiConfigs            UserAiConfigs?
  UserSecuritySettings     UserSecuritySettings?
  workflowStateChanges     WorkflowState[]
  createdWorkflows         Workflow[]
  testCaseChanges          TestCaseHistory[]
  createdTemplates         TestCaseTemplate[]
  testPlanAssignments      TestPlanTestCase[]
  createdTestPlans         TestPlan[]

  @@map("Users")
}

model UserSession {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  sessionToken String    @map("session_token") @db.Text
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.Text
  isActive     Boolean?  @map("is_active")
  createdAt    DateTime? @map("created_at") @db.DateTime(0)
  expiresAt    DateTime  @map("expires_at") @db.DateTime(0)
  login_type   String?   @default("password") @db.VarChar(20)

  @@index([userId], map: "user_id")
  @@map("UserSessions")
}

model Project {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(100)
  description   String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.DateTime(0)
  customReports CustomReport[]
  workflows     Workflow[]

  @@map("projects")
}

model Folder {
  id              Int               @id @default(autoincrement())
  folderName      String            @map("folder_name") @db.VarChar(100)
  folderType      String?           @map("folder_type") @db.VarChar(50)
  environment     String?           @db.VarChar(50)
  deploymentDate  DateTime?         @map("deployment_date") @db.Date
  parentFolderId  Int?              @map("parent_folder_id")
  projectId       Int?              @map("project_id")
  createdAt       DateTime          @default(now()) @map("created_at") @db.DateTime(0)
  AiConversations AiConversations[]
  parentFolder    Folder?           @relation("FolderChildren", fields: [parentFolderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "folders_ibfk_1")
  childFolders    Folder[]          @relation("FolderChildren")

  @@index([parentFolderId], map: "parent_folder_id")
  @@index([projectId], map: "project_id")
  @@map("Folders")
}

model TestCase {
  id                 Int                   @id @default(autoincrement())
  name               String                @db.VarChar(200)
  description        String?               @db.Text
  testType           String?               @map("test_type") @db.VarChar(50)
  scriptPath         String?               @map("script_path") @db.VarChar(500)
  folderId           Int?                  @map("folder_id")
  createdAt          DateTime              @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.DateTime(0)
  mainCategory       String?               @map("main_category") @db.VarChar(100)
  subCategory        String?               @map("sub_category") @db.VarChar(100)
  detailCategory     String?               @map("detail_category") @db.VarChar(100)
  preCondition       String?               @map("pre_condition") @db.Text
  expectedResult     String?               @map("expected_result") @db.Text
  remark             String?               @db.Text
  automationCodePath String?               @map("automation_code_path") @db.VarChar(500)
  environment        String?               @db.VarChar(50)
  creatorId          Int?                  @map("creator_id")
  priority           String?               @default("medium") @db.VarChar(20)
  status             String?               @default("draft") @db.VarChar(20)
  projectId          Int?                  @map("project_id")
  resultStatus       String                @default("pending") @map("result_status") @db.VarChar(20)
  automationCodeType String?               @map("automation_code_type") @db.VarChar(50)
  assigneeId         Int?                  @map("assignee_id")
  testSteps          String?               @map("test_steps") @db.Text
  tc_number          String?               @db.VarChar(50)
  jiraIntegrations   JiraIntegration[]
  jiraIssues         JiraIssue[]
  notifications      Notification[]        @relation("RelatedTestCaseNotifications")
  dataMappings       TestCaseDataMapping[]
  creator            User?                 @relation("CreatorTestCases", fields: [creatorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_testcases_creator")
  assignee           User?                 @relation("AssigneeTestCases", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_testcases_assignee")
  dependencies       TestDependency[]      @relation("DependentTestCases")
  dependedUponBy     TestDependency[]      @relation("RequiredTestCases")
  executions         TestExecution[]
  testResults        TestResult[]
  schedules          TestSchedule[]
  history            TestCaseHistory[]
  planLinks          TestPlanTestCase[]

  @@index([creatorId], map: "fk_test_cases_creator")
  @@index([projectId], map: "fk_testcases_project")
  @@index([folderId], map: "folder_id")
  @@index([assigneeId], map: "idx_testcases_assignee_id")
  @@index([creatorId], map: "idx_testcases_creator_id")
  @@index([environment], map: "idx_testcases_environment")
  @@index([folderId], map: "idx_testcases_folder_id")
  @@index([resultStatus], map: "idx_testcases_result_status")
  @@map("TestCases")
}

model TestCaseHistory {
  id         Int      @id @default(autoincrement())
  testCaseId Int      @map("test_case_id")
  fieldName  String   @map("field_name") @db.VarChar(100)
  oldValue   String?  @map("old_value") @db.Text
  newValue   String?  @map("new_value") @db.Text
  changedBy  Int      @map("changed_by")
  changedAt  DateTime @map("changed_at") @db.DateTime(0)
  changeType String   @map("change_type") @db.VarChar(50)
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "test_case_history_ibfk_1")
  user       User     @relation(fields: [changedBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "test_case_history_ibfk_2")

  @@index([changedBy], map: "changed_by")
  @@index([testCaseId], map: "test_case_history_ibfk_1")
  @@map("test_case_history")
}

model AutomationTest {
  id                    Int                     @id @default(autoincrement())
  name                  String                  @db.VarChar(200)
  description           String?                 @db.Text
  testType              String?                 @map("test_type") @db.VarChar(50)
  scriptPath            String?                 @map("script_path") @db.VarChar(500)
  environment           String?                 @db.VarChar(100)
  parameters            String?                 @db.Text
  createdAt             DateTime                @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.DateTime(0)
  creatorId             Int?                    @map("creator_id")
  projectId             Int?                    @map("project_id")
  assigneeId            Int?                    @map("assignee_id")
  AutomationTestResults AutomationTestResults[]
  assignee              User?                   @relation("AssigneeAutomationTests", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_automationtests_assignee")
  creator               User?                   @relation("CreatorAutomationTests", fields: [creatorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_automationtests_creator")
  jiraIntegrations      JiraIntegration[]
  jiraIssues            JiraIssue[]
  notifications         Notification[]          @relation("RelatedAutomationTestNotifications")
  executions            TestExecution[]
  testResults           TestResult[]

  @@index([creatorId], map: "fk_automation_tests_creator")
  @@index([projectId], map: "fk_automationtests_project")
  @@index([assigneeId], map: "idx_automationtests_assignee_id")
  @@map("AutomationTests")
}

model PerformanceTest {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @db.VarChar(200)
  description            String?                  @db.Text
  scriptPath             String?                  @map("script_path") @db.VarChar(500)
  environment            String?                  @db.VarChar(100)
  parameters             String?                  @db.Text
  createdAt              DateTime                 @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.DateTime(0)
  creatorId              Int?                     @map("creator_id")
  testType               String?                  @default("load") @map("test_type") @db.VarChar(50)
  projectId              Int?                     @map("project_id")
  assigneeId             Int?                     @map("assignee_id")
  jiraIntegrations       JiraIntegration[]
  jiraIssues             JiraIssue[]
  notifications          Notification[]           @relation("RelatedPerformanceTestNotifications")
  PerformanceTestResults PerformanceTestResults[]
  assignee               User?                    @relation("AssigneePerformanceTests", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_performancetests_assignee")
  creator                User?                    @relation("CreatorPerformanceTests", fields: [creatorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_performancetests_creator")
  executions             TestExecution[]
  testResults            TestResult[]

  @@index([creatorId], map: "fk_performance_tests_creator")
  @@index([projectId], map: "fk_performancetests_project")
  @@index([assigneeId], map: "idx_performancetests_assignee_id")
  @@map("PerformanceTests")
}

model TestResult {
  id                Int              @id @default(autoincrement())
  testCaseId        Int?             @map("test_case_id")
  result            String?          @db.VarChar(20)
  executionTime     Float?           @map("execution_time") @db.Float
  environment       String?          @db.VarChar(50)
  executedBy        String?          @map("executed_by") @db.VarChar(100)
  executedAt        DateTime         @default(now()) @map("executed_at") @db.DateTime(0)
  notes             String?          @db.Text
  automationTestId  Int?             @map("automation_test_id")
  performanceTestId Int?             @map("performance_test_id")
  executionDuration Float?           @map("execution_duration") @db.Float
  errorMessage      String?          @map("error_message") @db.Text
  notifications     Notification[]   @relation("RelatedTestResultNotifications")
  automationTest    AutomationTest?  @relation(fields: [automationTestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_automation_test")
  performanceTest   PerformanceTest? @relation(fields: [performanceTestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_performance_test")
  testCase          TestCase?        @relation(fields: [testCaseId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "testresults_ibfk_1")
  schedules         TestSchedule[]   @relation("LastRunResult")

  @@index([automationTestId], map: "fk_automation_test")
  @@index([performanceTestId], map: "fk_performance_test")
  @@index([environment], map: "idx_testresults_environment")
  @@index([executedAt], map: "idx_testresults_executed_at")
  @@index([result], map: "idx_testresults_result")
  @@index([testCaseId], map: "test_case_id")
  @@map("TestResults")
}

model TestExecution {
  id                Int              @id @default(autoincrement())
  testCaseId        Int?             @map("test_case_id")
  status            String?          @db.VarChar(20)
  execution_time    Float?           @db.Float
  result_data       String?          @db.Text
  created_at        DateTime?        @default(now()) @db.DateTime(0)
  testType          String?          @map("test_type") @db.VarChar(50)
  automationTestId  Int?             @map("automation_test_id")
  performanceTestId Int?             @map("performance_test_id")
  environment       String?          @db.VarChar(50)
  executedBy        String?          @map("executed_by") @db.VarChar(100)
  startedAt         DateTime?        @default(now()) @map("started_at") @db.DateTime(0)
  completedAt       DateTime?        @map("completed_at") @db.DateTime(0)
  resultSummary     String?          @map("result_summary") @db.Text
  automationTest    AutomationTest?  @relation(fields: [automationTestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_execution_automation_test")
  performanceTest   PerformanceTest? @relation(fields: [performanceTestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_execution_performance_test")
  testCase          TestCase?        @relation(fields: [testCaseId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "testexecutions_ibfk_1")

  @@index([automationTestId], map: "fk_execution_automation_test")
  @@index([performanceTestId], map: "fk_execution_performance_test")
  @@index([testCaseId], map: "test_case_id")
  @@map("TestExecutions")
}

model Screenshot {
  id           Int       @id @default(autoincrement())
  testResultId Int?      @map("test_result_id")
  filePath     String?   @map("file_path") @db.VarChar(500)
  createdAt    DateTime? @map("created_at") @db.DateTime(0)

  @@index([testResultId], map: "test_result_id")
  @@map("Screenshots")
}

model DashboardSummary {
  id           Int       @id @default(autoincrement())
  environment  String?   @db.VarChar(100)
  totalTests   Int?      @map("total_tests")
  passedTests  Int?      @map("passed_tests")
  failedTests  Int?      @map("failed_tests")
  skippedTests Int?      @map("skipped_tests")
  passRate     Float?    @map("pass_rate") @db.Float
  lastUpdated  DateTime? @map("last_updated") @db.DateTime(0)

  @@map("DashboardSummaries")
}

model TestCaseTemplate {
  id                 Int       @id @default(autoincrement())
  name               String    @db.VarChar(200)
  description        String?   @db.Text
  mainCategory       String?   @map("main_category") @db.VarChar(100)
  subCategory        String?   @map("sub_category") @db.VarChar(100)
  detailCategory     String?   @map("detail_category") @db.VarChar(100)
  preCondition       String?   @map("pre_condition") @db.Text
  expectedResult     String?   @map("expected_result") @db.Text
  testSteps          String?   @map("test_steps") @db.Text
  automationCodePath String?   @map("automation_code_path") @db.VarChar(500)
  automationCodeType String?   @map("automation_code_type") @db.VarChar(50)
  tags               String?   @db.Text
  createdBy          Int       @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime? @updatedAt @map("updated_at") @db.DateTime(0)
  isPublic           Boolean   @default(false) @map("is_public")
  usageCount         Int?      @map("usage_count")
  creator            User      @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "test_case_templates_ibfk_1")

  @@index([createdBy], map: "created_by")
  @@map("test_case_templates")
}

model TestPlan {
  id          Int                @id @default(autoincrement())
  name        String             @db.VarChar(200)
  description String?            @db.Text
  version     String?            @db.VarChar(50)
  environment String?            @db.VarChar(50)
  startDate   DateTime?          @map("start_date") @db.Date
  endDate     DateTime?          @map("end_date") @db.Date
  status      String?            @db.VarChar(50)
  priority    String?            @db.VarChar(20)
  createdBy   Int                @map("created_by")
  createdAt   DateTime           @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime?          @updatedAt @map("updated_at") @db.DateTime(0)
  testCases   TestPlanTestCase[]
  creator     User               @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "test_plans_ibfk_1")

  @@index([createdBy], map: "created_by")
  @@map("test_plans")
}

model TestPlanTestCase {
  id                Int      @id @default(autoincrement())
  testPlanId        Int      @map("test_plan_id")
  testCaseId        Int      @map("test_case_id")
  executionOrder    Int?     @map("execution_order")
  estimatedDuration Int?     @map("estimated_duration")
  assignedTo        Int?     @map("assigned_to")
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(0)
  testPlan          TestPlan @relation(fields: [testPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "test_plan_test_cases_ibfk_1")
  testCase          TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "test_plan_test_cases_ibfk_2")
  assignee          User?    @relation(fields: [assignedTo], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "test_plan_test_cases_ibfk_3")

  @@index([assignedTo], map: "assigned_to")
  @@index([testPlanId], map: "test_plan_id")
  @@index([testCaseId], map: "test_plan_test_cases_ibfk_2")
  @@map("test_plan_test_cases")
}

model JiraIssue {
  id                Int              @id @default(autoincrement())
  issueKey          String           @unique(map: "issue_key") @map("issue_key") @db.VarChar(20)
  projectKey        String           @map("project_key") @db.VarChar(20)
  issueType         String           @map("issue_type") @db.VarChar(50)
  status            String           @db.VarChar(50)
  priority          String           @default("Medium") @db.VarChar(20)
  summary           String           @db.Text
  description       String?          @db.Text
  assigneeEmail     String?          @map("assignee_email") @db.VarChar(100)
  labels            String?          @db.Text
  reporterEmail     String?          @map("reporter_email") @db.VarChar(100)
  environment       String?          @default("dev") @db.VarChar(50)
  testCaseId        Int?             @map("test_case_id")
  automationTestId  Int?             @map("automation_test_id")
  performanceTestId Int?             @map("performance_test_id")
  createdAt         DateTime         @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.DateTime(0)
  comments          JiraComment[]
  testCase          TestCase?        @relation(fields: [testCaseId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "jiraissues_ibfk_1")
  automationTest    AutomationTest?  @relation(fields: [automationTestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "jiraissues_ibfk_2")
  performanceTest   PerformanceTest? @relation(fields: [performanceTestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "jiraissues_ibfk_3")

  @@index([automationTestId], map: "automation_test_id")
  @@index([testCaseId], map: "jiraissues_ibfk_1")
  @@index([performanceTestId], map: "performance_test_id")
  @@map("JiraIssues")
}

model JiraComment {
  id          Int       @id @default(autoincrement())
  jiraIssueId Int       @map("jira_issue_id")
  body        String    @db.Text
  authorEmail String    @map("author_email") @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(0)
  jiraIssue   JiraIssue @relation(fields: [jiraIssueId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "jiracomments_ibfk_1")

  @@index([jiraIssueId], map: "jira_issue_id")
  @@map("JiraComments")
}

/// @deprecated JiraIssue 사용 권장
model JiraIntegration {
  id                Int              @id @default(autoincrement())
  testCaseId        Int?             @map("test_case_id")
  automationTestId  Int?             @map("automation_test_id")
  performanceTestId Int?             @map("performance_test_id")
  jiraIssueKey      String           @map("jira_issue_key") @db.VarChar(20)
  jiraIssueId       String           @map("jira_issue_id") @db.VarChar(50)
  jiraProjectKey    String           @map("jira_project_key") @db.VarChar(20)
  issueType         String           @map("issue_type") @db.VarChar(50)
  status            String           @db.VarChar(50)
  priority          String?          @db.VarChar(20)
  summary           String?          @db.Text
  description       String?          @db.Text
  assigneeAccountId String?          @map("assignee_account_id") @db.VarChar(100)
  labels            String?          @db.Text
  createdAt         DateTime?        @map("created_at") @db.DateTime(0)
  updatedAt         DateTime?        @updatedAt @map("updated_at") @db.DateTime(0)
  lastSyncAt        DateTime?        @map("last_sync_at") @db.DateTime(0)
  testCase          TestCase?        @relation(fields: [testCaseId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "jiraintegrations_ibfk_1")
  automationTest    AutomationTest?  @relation(fields: [automationTestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "jiraintegrations_ibfk_2")
  performanceTest   PerformanceTest? @relation(fields: [performanceTestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "jiraintegrations_ibfk_3")

  @@index([automationTestId], map: "automation_test_id")
  @@index([testCaseId], map: "jiraintegrations_ibfk_1")
  @@index([performanceTestId], map: "performance_test_id")
  @@map("JiraIntegrations")
}

model TestSchedule {
  id                  Int         @id @default(autoincrement())
  testCaseId          Int         @map("test_case_id")
  name                String      @db.VarChar(200)
  description         String?     @db.Text
  scheduleType        String      @map("schedule_type") @db.VarChar(50)
  scheduleExpression  String?     @map("schedule_expression") @db.VarChar(200)
  enabled             Boolean    @default(true)
  active              Boolean    @default(true)
  nextRunAt           DateTime?   @map("next_run_at") @db.DateTime(0)
  lastRunAt           DateTime?   @map("last_run_at") @db.DateTime(0)
  lastRunStatus       String?     @map("last_run_status") @db.VarChar(20)
  lastRunResultId     Int?        @map("last_run_result_id")
  environment         String?     @db.VarChar(50)
  executionParameters String?     @map("execution_parameters") @db.Text
  createdBy           Int         @map("created_by")
  createdAt           DateTime    @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.DateTime(0)
  testCase            TestCase    @relation(fields: [testCaseId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "testschedules_ibfk_1")
  lastRunResult       TestResult? @relation("LastRunResult", fields: [lastRunResultId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "testschedules_ibfk_2")
  creator             User        @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "testschedules_ibfk_3")

  @@index([createdBy], map: "created_by")
  @@index([lastRunResultId], map: "last_run_result_id")
  @@index([testCaseId], map: "testschedules_ibfk_1")
  @@map("TestSchedules")
}

model Notification {
  id                       Int              @id @default(autoincrement())
  userId                   Int              @map("user_id")
  notificationType         String           @map("notification_type") @db.VarChar(50)
  title                    String           @db.VarChar(200)
  message                  String           @db.Text
  relatedTestCaseId        Int?             @map("related_test_case_id")
  relatedAutomationTestId  Int?             @map("related_automation_test_id")
  relatedPerformanceTestId Int?             @map("related_performance_test_id")
  relatedTestResultId      Int?             @map("related_test_result_id")
  read                     Boolean          @default(false)
